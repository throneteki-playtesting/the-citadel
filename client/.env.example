# Copy to `client/.env` and fill in the blanks.
# Vite only exposes variables prefixed with VITE_ to the browser — never put
# secrets in here.

VITE_SERVER_HOST=http://localhost:8080

# Should match the server's DISCORD_SERVER_INVITE_URL / BUG_REPORT_URL.
VITE_DISCORD_SERVER_INVITE_URL=
VITE_BUG_REPORT_URL=

# Sentry error reporting; leave blank to disable.
VITE_SENTRY_DSN=
