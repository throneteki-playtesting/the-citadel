# Copy to `server/.env` and fill in the blanks.
# Values already filled in are safe local-development defaults.

# --- Core ---------------------------------------------------------------
NODE_ENV=development
VERBOSE=FALSE

SERVER_PORT=8080
SERVER_HOST=http://localhost:${SERVER_PORT}
CLIENT_PORT=5173
CLIENT_HOST=http://localhost:${CLIENT_PORT}

# --- Datastores ---------------------------------------------------------
DATABASE_NAME=thecitadel
DATABASE_URL=mongodb://localhost:27017/${DATABASE_NAME}

REDIS_PORT=6379
# Any logical database index here is ignored — the server picks one from NODE_ENV so environments
# sharing an instance cannot overwrite each other's keys.
REDIS_HOST=redis://localhost:${REDIS_PORT}

# --- Auth ---------------------------------------------------------------
# Any long random string; invalidates all sessions when changed.
JWT_SECRET=
# Seconds
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=604800
IMPERSONATION_TOKEN_TTL=14400
REFRESH_GRACE_MS=30000

# --- Discord ------------------------------------------------------------
# From https://discord.com/developers/applications — the bot handles OAuth
# login, card forum threads and review threads.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Guild the bot operates in.
DISCORD_GUILD_ID=
DISCORD_AUTH_REDIRECT=${SERVER_HOST}/auth/discord/callback
DISCORD_SERVER_INVITE_URL=
# Where the in-app "report a bug" button points. Supports discord:// deep links.
BUG_REPORT_URL=

# --- GitHub -------------------------------------------------------------
# GitHub App credentials used to open PRs against the card data repos.
# Leave any of these blank to disable the integration entirely
GITHUB_OWNER=
GITHUB_REPOSITORY=
GITHUB_REPOSITORY_DATA=
GITHUB_APP_ID=
# PEM contents, newlines escaped as \n
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- ThronesDB ----------------------------------------------------------
# OAuth client for importing decks from https://thronesdb.com
THRONESDB_CLIENT_ID=
THRONESDB_CLIENT_SECRET=

# --- Google -------------------------------------------------------------
# Service account for the legacy Apps Script / Sheets data source.
# Leave blank unless you need the GAS integration.
GOOGLE_PRIVATE_KEY=
GOOGLE_CLIENT_EMAIL=

# --- S3 (card image storage) -------------------------------------------
# Any S3-compatible endpoint.
S3_BASE_URL=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Optional -----------------------------------------------------------
# Generic outbound webhook for server notifications.
WEBHOOK_URL=
# Sentry error reporting; leave blank to disable.
SENTRY_SERVER_DSN=
SENTRY_CLIENT_DSN=
