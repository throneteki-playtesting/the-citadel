{
    "name": "the-citadel",
    "version": "2.0.0",
    "description": "Playtesting management for A Game of Thrones: The Card Game (2nd Edition)",
    "type": "module",
    "scripts": {
        "install:all": "npm --prefix common install && npm --prefix server install && npm --prefix client install",
        "dev:server": "npm --prefix server run dev",
        "dev:client": "npm --prefix client run dev",
        "build": "npm --prefix client run build",
        "lint": "npm --prefix server run lint && npm --prefix client run lint",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "author": "Stephen Patane",
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^9.27.0",
        "@typescript-eslint/eslint-plugin": "^8.38.0",
        "@typescript-eslint/parser": "^8.38.0",
        "eslint": "^8.57.1",
        "eslint-plugin-prettier": "^5.5.3",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.20",
        "globals": "^16.2.0",
        "prettier": "^3.6.2",
        "typescript-eslint": "^8.32.1"
    }
}
